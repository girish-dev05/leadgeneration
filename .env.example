APP_NAME=Lead Engine
APP_HOST=127.0.0.1
APP_PORT=8000

# If set, DATABASE_URL takes priority (recommended for Render Postgres).
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=lead_engine

DEFAULT_REGION=IN

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=youremail@gmail.com

OUTREACH_ENABLED=false
OUTREACH_BATCH_SIZE=10

CALL_AGENT_WEBHOOK=
CALL_AGENT_TOKEN=
